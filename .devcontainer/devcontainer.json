{
  "name": "iotaTime Idris 2",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "installZsh": true,
      "upgradePackages": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "zjhmale.idris2-lsp",
        "redhat.vscode-yaml",
        "github.vscode-github-actions",
        "eamodio.gitlens"
      ],
      "settings": {
        "idris2.idrisCommand": "/usr/local/bin/idris2"
      }
    }
  },
  "postCreateCommand": "idris2 --version",
  "remoteUser": "vscode"
}
