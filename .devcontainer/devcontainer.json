{
  "name": "iotaTime Idris 2",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "installZsh": true,
      "upgradePackages": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bamboo.idris2-lsp",
        "redhat.vscode-yaml",
        "github.vscode-github-actions",
        "eamodio.gitlens"
      ],
      "settings": {
        "idris2-lsp.path": "/home/vscode/.local/bin/idris2-lsp"
      }
    }
  },
  "postCreateCommand": "git lfs install && idris2 --version && pack info && idris2-lsp --version && node --version && gh --version",
  "remoteUser": "vscode"
}
