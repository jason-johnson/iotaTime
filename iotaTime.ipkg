package iotaTime

version = 0.2.0
authors = "Jason Johnson"
maintainers = "Jason Johnson"
license = "BSD-3-Clause"
brief = "Proof-oriented date, time, calendar, and timezone types for Idris 2"
readme = "README.md"
homepage = "https://github.com/jason-johnson/iotaTime"
sourceloc = "https://github.com/jason-johnson/iotaTime"
bugtracker = "https://github.com/jason-johnson/iotaTime/issues"

depends = contrib, elab-util

sourcedir = "src"

prebuild = "make support"
postinstall = "make install-support"
postclean = "make clean-support"

modules = IotaTime.Duration,
		  IotaTime.Clock,
		  IotaTime.DateTimeZone,
		  IotaTime.Instant,
		  IotaTime.Interval,
		  IotaTime.Offset,
		  IotaTime.OffsetDateTime,
		  IotaTime.Period,
		  IotaTime.ZonedDateTime,
		  IotaTime.Tzdb.Tzif,
		  IotaTime.Tzdb.Posix,
		  IotaTime.Tzdb.Windows.Types,
		  IotaTime.Tzdb.Provider,
		  IotaTime.Tzdb.Windows,
		  IotaTime.Tzdb.Windows.Platform,
		  IotaTime.Tzdb,
		  IotaTime.Time.Component,
		  IotaTime.LocalTime,
		  IotaTime.Calendar.Component,
		  IotaTime.Calendar,
		  IotaTime.Calendar.Gregorian,
		  IotaTime.Calendar.Iso,
		  IotaTime.Calendar.Coptic,
		  IotaTime.Calendar.Islamic,
		  IotaTime.Calendar.Persian,
		  IotaTime.Calendar.Julian,
		  IotaTime.Calendar.Hebrew,
		  IotaTime.Locale.Unix.Platform,
		  IotaTime.Locale.Windows.Platform,
		  IotaTime.Locale,
		  IotaTime.Pattern,
		  IotaTime.Pattern.Calendar,
		  IotaTime.Pattern.CalendarDate,
		  IotaTime.Pattern.LocalTime,
		  IotaTime.Pattern.Offset,
		  IotaTime.Pattern.Duration,
		  IotaTime.Pattern.Instant,
		  IotaTime.Pattern.CalendarDateTime,
		  IotaTime.Pattern.OffsetDateTime,
		  IotaTime.Pattern.ZonedDateTime,
		  IotaTime.Pattern.Locale,
		  IotaTime.CalendarDateTime,
		  IotaTime.Pure,
		  IotaTime
